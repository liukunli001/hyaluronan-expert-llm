\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The HA-Expert pipeline. \textbf  {Training:} the 12,306-paper corpus is tokenized for domain-adaptive pretraining (DAPT) of Qwen3-8B-Base, which then generates its own grounding-filtered SFT data. \textbf  {Retrieval:} the corpus is chunked into a FAISS index of 636,959 passages; the top-4 are prepended at inference (RAG on; off: parameters alone). \textbf  {Evaluation:} all four configurations are scored on HA-Expert-Bench's 240 evidence-checked questions.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{4}{The HA-Expert pipeline. \textbf {Training:} the 12,306-paper corpus is tokenized for domain-adaptive pretraining (DAPT) of Qwen3-8B-Base, which then generates its own grounding-filtered SFT data. \textbf {Retrieval:} the corpus is chunked into a FAISS index of 636,959 passages; the top-4 are prepended at inference (RAG on; off: parameters alone). \textbf {Evaluation:} all four configurations are scored on HA-Expert-Bench's 240 evidence-checked questions}{figure.1}{}}
