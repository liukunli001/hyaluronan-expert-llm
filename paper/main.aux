\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Worked example --- trap question G13: ``HA solutions are simple Newtonian fluids, so their viscosity is a single constant, correct?'' Reference key: false (HA solutions are non-Newtonian and shear-thinning). Responses are verbatim excerpts from the Section~\ref {sec:experiments} run; ellipses mark trimming. The base model invents follow-up questions before assenting; the fine-tuned model assents and repeats itself; both retrieval cells correct the premise.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:example}{{4}{9}{Worked example --- trap question G13: ``HA solutions are simple Newtonian fluids, so their viscosity is a single constant, correct?'' Reference key: false (HA solutions are non-Newtonian and shear-thinning). Responses are verbatim excerpts from the Section~\ref {sec:experiments} run; ellipses mark trimming. The base model invents follow-up questions before assenting; the fine-tuned model assents and repeats itself; both retrieval cells correct the premise}{table.4}{}}
